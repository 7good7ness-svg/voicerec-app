{
  "name": "kairos-bot",
  "version": "1.0.0",
  "description": "Kairos風 AI秘書ボット — LINE/Telegramで動く経費管理・記録アプリ",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
