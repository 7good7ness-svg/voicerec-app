# ===== Kairos Bot 環境変数 =====

# Telegram Bot Token（@BotFather で取得）
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Anthropic API キー（https://console.anthropic.com/ で取得）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# 使用する Claude モデル（省略時は claude-opus-4-8）
# 大量メッセージでコストを抑えたい場合は claude-haiku-4-5 に変更可
CLAUDE_MODEL=claude-opus-4-8

# SQLite DBファイルの保存先（省略時は ./data/kairos.db）
DATABASE_PATH=./data/kairos.db

# タイムゾーン（省略時は Asia/Tokyo）
TZ=Asia/Tokyo

# 通貨（省略時は JPY）
DEFAULT_CURRENCY=JPY
